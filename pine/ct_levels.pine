//@version=6
// C&T Levels - permanent indicator for Protocol Coffee and Tea.
//
// Add this ONCE. After each session, click "Copy levels for TradingView" in
// gex-visualizer, then paste into this indicator's settings ("Levels" box).
// No Pine Editor, no re-saving. The code never needs to change per session.
//
// Data format (one record per line, "|"-separated), produced by the app:
//   CT|<session date YYYY-MM-DD>|<ticker>           header
//   <code>|<price>|<label>|<line width>|<label offset in bars>
// Codes: WP positive wall, WN negative wall, F gamma flip, A POC/VA, M moving
// average, TH thesis range/target, IM implied range, E strategy entry,
// X invalidation, T 50% target (SPY equivalent), S price stop (SPY
// equivalent), BE breakeven.
//
// GEX walls are zones where dealer hedging tends to slow price, not levels
// that contain it.

indicator("C&T Levels", "C&T", overlay = true, max_lines_count = 200, max_labels_count = 200)

TZ = "America/New_York"

data = input.text_area("CT|0000-00-00|SPY", "Levels",
     tooltip = "Paste the block from gex-visualizer's 'Copy levels for TradingView' button. Replace everything in this box each session.")

gm = "Display"
dispMode  = input.string("Focus", "Mode", options = ["Focus", "Full"], group = gm,
     tooltip = "Focus: the nearest walls each side of price, the gamma flip, and plan entry / 50% / stop / invalidation only. Full: everything switched on below.")
wallsEach = input.int(2, "Focus: walls shown each side of price", minval = 1, maxval = 10, group = gm)
planSel   = input.string("All", "Plan lines to show", options = ["All", "S1", "S2", "S3", "None"], group = gm,
     tooltip = "Show one plan's lines at a time to cut clutter. The plans box always lists every plan.")
focus = dispMode == "Focus"

gs = "Show (Full mode)"
gW = input.bool(true, "GEX walls + flip", group = gs)
gA = input.bool(true, "POC / VA / MAs", group = gs)
gE = input.bool(true, "Strategy entry + invalidation", group = gs)
gX = input.bool(true, "Strategy 50% target + price stop", group = gs)
gT = input.bool(true, "Thesis range + targets", group = gs)
gI = input.bool(false, "Implied 1-sigma range", group = gs)
gB = input.bool(false, "Strategy breakevens", group = gs)
showLabels = input.bool(true, "Labels", group = gs)
labelSize  = input.string("small", "Label size", options = ["small", "normal", "large"], group = gs)
crowdGap   = input.float(0.5, "Stagger labels closer than (points)", minval = 0, step = 0.1, group = gs,
     tooltip = "Labels whose prices are this close get pushed sideways so they don't overlap. Raise it if labels still collide when zoomed out.")
showStatus = input.bool(true, "Status box (date / freshness check)", group = gs)
showPlans  = input.bool(true, "Plans box", group = gs)
plansFull  = input.bool(false, "Plans box: show invalidation + trade details", group = gs)
plansPos   = input.string("middle right", "Plans box position", options = ["middle right", "top right", "bottom left", "top left"], group = gs)
atEntryPts = input.float(0.25, "Plans box: 'at entry' within (points)", minval = 0, step = 0.05, group = gs)

gc = "Colours"
cPos    = input.color(color.rgb(38, 198, 166), "Positive gamma wall", group = gc)
cNeg    = input.color(color.rgb(255, 82, 82), "Negative gamma wall", group = gc)
cFlip   = input.color(color.rgb(255, 171, 64), "Gamma flip", group = gc)
cVolP   = input.color(color.rgb(206, 147, 216), "POC / VA", group = gc)
cMa     = input.color(color.rgb(176, 190, 197), "MAs / breakevens", group = gc)
cThesis = input.color(color.rgb(100, 181, 246), "Thesis range / targets", group = gc)
cImpl   = input.color(color.rgb(158, 158, 158), "Implied range", group = gc)
cEntry  = input.color(color.rgb(105, 240, 174), "Strategy entry", group = gc)
cInval  = input.color(color.rgb(240, 98, 146), "Strategy invalidation", group = gc)
cTarget = input.color(color.rgb(0, 229, 255), "50% target", group = gc)
cStopPx = input.color(color.rgb(255, 64, 129), "Price stop", group = gc)

lblSize = labelSize == "small" ? size.small : labelSize == "large" ? size.large : size.normal

codeColor(string c) =>
    switch c
        "WP" => cPos
        "WN" => cNeg
        "F"  => cFlip
        "A"  => cVolP
        "M"  => cMa
        "TH" => cThesis
        "IM" => cImpl
        "E"  => cEntry
        "X"  => cInval
        "T"  => cTarget
        "S"  => cStopPx
        "BE" => cMa
        => color.gray

codeOn(string c) =>
    switch c
        "WP" => gW
        "WN" => gW
        "F"  => gW
        "A"  => gA
        "M"  => gA
        "E"  => gE
        "X"  => gE
        "T"  => gX
        "S"  => gX
        "TH" => gT
        "IM" => gI
        "BE" => gB
        => true

codeStyle(string c) =>
    c == "WP" or c == "WN" or c == "A" ? line.style_solid : c == "IM" ? line.style_dotted : line.style_dashed

// ── Parse once (inputs only change by re-running the whole script)
var array<string> codes  = array.new<string>()
var array<float>  prices = array.new<float>()
var array<string> texts  = array.new<string>()
var array<int>    widths = array.new<int>()
var array<int>    offs   = array.new<int>()
var string hdrDate   = ""
var string hdrTicker = ""
var int    badLines  = 0
var array<string> plName  = array.new<string>()
var array<float>  plEntry = array.new<float>()
var array<float>  plTgt   = array.new<float>()
var array<float>  plStop  = array.new<float>()
var array<float>  plInv   = array.new<float>()
var array<string> plInfo  = array.new<string>()
var array<string> plQty   = array.new<string>()

if barstate.isfirst
    for raw in str.split(data, "\n")
        row = str.trim(raw)
        if row == ""
            continue
        f = str.split(row, "|")
        if f.size() >= 3 and f.get(0) == "CT"
            hdrDate   := f.get(1)
            hdrTicker := f.get(2)
        else if f.size() >= 3 and f.get(0) == "L"
            // L|n|name|entry|50% target|price stop|invalidation|summary (extra fields optional)
            plName.push("S" + f.get(1) + "  " + f.get(2))
            plEntry.push(f.size() > 3 ? str.tonumber(f.get(3)) : na)
            plTgt.push(f.size() > 4 ? str.tonumber(f.get(4)) : na)
            plStop.push(f.size() > 5 ? str.tonumber(f.get(5)) : na)
            plInv.push(f.size() > 6 ? str.tonumber(f.get(6)) : na)
            plInfo.push(f.size() > 7 ? f.get(7) : "")
            // "7x · 0DTE" / "7x · exp 09-25" (fields 9-10, optional)
            q = f.size() > 8 ? f.get(8) : ""
            ex = f.size() > 9 ? f.get(9) : ""
            exTxt = ex == "" ? "" : ex == hdrDate ? "0DTE" : "exp " + (str.length(ex) >= 10 ? str.substring(ex, 5, 10) : ex)
            plQty.push((q == "" ? "" : q + "x") + (q != "" and exTxt != "" ? " · " : "") + exTxt)
        else if f.size() >= 3
            px = str.tonumber(f.get(1))
            if na(px)
                badLines += 1
            else
                codes.push(str.upper(f.get(0)))
                prices.push(px)
                texts.push(f.get(2))
                w = f.size() >= 4 ? str.tonumber(f.get(3)) : na
                widths.push(na(w) ? 2 : int(w))
                o = f.size() >= 5 ? str.tonumber(f.get(4)) : na
                offs.push(na(o) ? 2 : int(o))
        else
            badLines += 1

// ── Which levels to show. Evaluated on the last bar, because Focus mode
// depends on where price is now.
isWall(string c) => c == "WP" or c == "WN"
isPlanLine(string c) => c == "E" or c == "X" or c == "T" or c == "S" or c == "BE"

// Number of walls on the same side of price that are closer than wall i.
wallRank(int i) =>
    px = prices.get(i)
    above = px >= close
    int rank = 0
    for j = 0 to codes.size() - 1
        if j != i and isWall(codes.get(j))
            pj = prices.get(j)
            if (pj >= close) == above and math.abs(pj - close) < math.abs(px - close)
                rank += 1
    rank

visible(int i) =>
    c = codes.get(i)
    bool ok = true
    if focus
        ok := c == "F" or (isWall(c) and wallRank(i) < wallsEach) or c == "E" or c == "X" or c == "T" or c == "S"
    else
        ok := codeOn(c)
    if ok and isPlanLine(c)
        ok := planSel == "All" or (planSel != "None" and str.startswith(texts.get(i), planSel + " "))
    ok

// ── Lines + labels (recreated on the last bar so they follow price).
// Levels at the SAME price share one label ("766 -195M · S2 entry"), and
// nearby labels are staggered sideways so nothing overlaps.
var line[]  lns  = array.new<line>()
var label[] labs = array.new<label>()
if barstate.islast
    for l in lns
        l.delete()
    lns.clear()
    for l in labs
        l.delete()
    labs.clear()
    if codes.size() > 0
        vp = array.new<float>()
        vt = array.new<string>()
        vc = array.new<color>()
        seen = map.new<float, int>()
        for i = 0 to codes.size() - 1
            if visible(i)
                c = codes.get(i)
                px = prices.get(i)
                lns.push(line.new(bar_index - 1, px, bar_index, px, extend = extend.both,
                     color = codeColor(c), width = widths.get(i), style = codeStyle(c)))
                if seen.contains(px)
                    k = seen.get(px)
                    vt.set(k, vt.get(k) + " · " + texts.get(i))
                else
                    seen.put(px, vp.size())
                    vp.push(px)
                    vt.push(texts.get(i))
                    vc.push(codeColor(c))
        if showLabels and vp.size() > 0
            idx = vp.sort_indices(order.ascending)
            float prevPx = na
            int prevOff = 0
            for j = 0 to idx.size() - 1
                k = idx.get(j)
                px = vp.get(k)
                off = not na(prevPx) and px - prevPx < crowdGap ? (prevOff >= 38 ? 2 : prevOff + 18) : 2
                labs.push(label.new(bar_index + off, px, vt.get(k), style = label.style_label_left,
                     color = color.new(vc.get(k), 10), textcolor = color.black, size = lblSize))
                prevPx := px
                prevOff := off

// ── Status box: is this today's data, for this ticker?
var table status = table.new(position.bottom_right, 1, 2, bgcolor = color.new(#131722, 10),
     border_color = color.new(#363A45, 0), border_width = 1)
if showStatus and barstate.islast
    today = str.format_time(timenow, "yyyy-MM-dd", TZ)
    string msg = ""
    color bg = color.new(color.teal, 30)
    if hdrDate == "" or hdrDate == "0000-00-00"
        msg := "No levels yet - paste from gex-visualizer into this indicator's settings"
        bg  := color.new(color.gray, 30)
    else if hdrTicker != "" and syminfo.ticker != hdrTicker
        msg := "These levels are for " + hdrTicker + " - this chart is " + syminfo.ticker
        bg  := color.new(color.red, 20)
    else if hdrDate != today
        msg := "Levels are from " + hdrDate + " - not today (" + today + " NY)"
        bg  := color.new(color.red, 20)
    else
        msg := "Levels OK - " + hdrDate + (focus ? " (Focus mode)" : "")
    table.cell(status, 0, 0, "C&T " + hdrDate, text_color = color.gray, text_size = size.small)
    table.cell(status, 0, 1, msg + (badLines > 0 ? " | " + str.tostring(badLines) + " unreadable line(s)" : ""),
         text_color = color.white, bgcolor = bg, text_size = size.small)

// ── Plans box: one row per strategy, with its SPY levels and how far price
// is from the entry right now. Levels are the SPY equivalents from the
// session (50% target and price stop assume the move happens soon after
// entry - see the PDF for the premium-based exits).
fmtPx(float x) => na(x) ? "-" : str.tostring(x, "#.##")
var table plans = table.new(plansPos == "top right" ? position.top_right : plansPos == "bottom left" ? position.bottom_left :
     plansPos == "top left" ? position.top_left : position.middle_right, 8, 11,
     bgcolor = color.new(#131722, 5), border_color = color.new(#363A45, 0), border_width = 1)
if showPlans and barstate.islast and plName.size() > 0
    table.clear(plans, 0, 0, 7, 10)  // drop cells left over from the wider layout
    hdr = plansFull ? array.from("Plan", "Contracts", "Entry", "50% tgt", "Stop", "Inval", "Trade", "vs entry") :
         array.from("Plan", "Contracts", "Entry", "50% tgt", "Stop", "vs entry")
    for c = 0 to hdr.size() - 1
        table.cell(plans, c, 0, hdr.get(c), text_color = color.gray, text_size = size.small)
    for i = 0 to math.min(plName.size(), 10) - 1
        r = i + 1
        e = plEntry.get(i)
        d = na(e) ? na : close - e
        string dist = na(d) ? "-" : math.abs(d) <= atEntryPts ? "AT ENTRY" : (d > 0 ? "+" : "") + str.tostring(d, "#.##")
        color distBg = na(d) ? na : math.abs(d) <= atEntryPts ? color.new(cEntry, 20) : na
        selected = planSel == "S" + str.tostring(i + 1)
        color rowBg = selected ? color.new(color.white, 88) : na
        color nameCol = planSel == "All" or selected ? color.white : color.gray
        table.cell(plans, 0, r, plName.get(i), text_color = nameCol, bgcolor = rowBg, text_size = size.small, text_halign = text.align_left)
        table.cell(plans, 1, r, plQty.size() > i ? plQty.get(i) : "-", text_color = color.white, bgcolor = rowBg, text_size = size.small)
        table.cell(plans, 2, r, fmtPx(e), text_color = cEntry, bgcolor = rowBg, text_size = size.small)
        table.cell(plans, 3, r, fmtPx(plTgt.get(i)), text_color = cTarget, bgcolor = rowBg, text_size = size.small)
        table.cell(plans, 4, r, fmtPx(plStop.get(i)), text_color = cStopPx, bgcolor = rowBg, text_size = size.small)
        if plansFull
            table.cell(plans, 5, r, fmtPx(plInv.get(i)), text_color = cInval, bgcolor = rowBg, text_size = size.small)
            table.cell(plans, 6, r, plInfo.get(i), text_color = color.silver, bgcolor = rowBg, text_size = size.small, text_halign = text.align_left)
        table.cell(plans, plansFull ? 7 : 5, r, dist, text_color = color.white, bgcolor = na(distBg) ? rowBg : distBg, text_size = size.small)

// ── Alerts: one TradingView alert covers every plan and every event.
// Create it with Condition = "C&T" -> "Any alert() function call".
// Each event fires once per plan per day. "Touched" means the bar's range
// reached the level (not a close beyond it) - an early warning, not a
// confirmed break. Alerts only fire in real time, never on history.
// NOTE: TradingView alerts keep the settings they were created with, so
// after pasting new levels you must delete and recreate the alert.
ga = "Alerts"
alertOn    = input.bool(true, "Send alerts", group = ga,
     tooltip = "Also needs one TradingView alert: Alert -> Condition: C&T -> 'Any alert() function call'. Recreate it after each new levels paste.")
alertScope = input.string("All plans", "Alert on", options = ["All plans", "Picked plan only"], group = ga,
     tooltip = "Picked plan = the one chosen in Display -> Plan lines to show.")
aApproach  = input.float(0.5, "Heads-up when price is within (points of an entry, 0 = off)", minval = 0, step = 0.05, group = ga)
aEntry     = input.bool(true, "Entry touched", group = ga)
aTgt       = input.bool(true, "50% target touched", group = ga)
aStop      = input.bool(true, "Price stop touched", group = ga)
aInv       = input.bool(true, "Invalidation touched", group = ga)

newDay = timeframe.change("D")
// Per plan, a string of event letters already sent today: A approach,
// E entry, T target, S stop, I invalidation.
var array<string> fired = array.new<string>()
if fired.size() != plName.size()
    fired := array.new<string>(plName.size(), "")
if newDay and fired.size() > 0
    for i = 0 to fired.size() - 1
        fired.set(i, "")

touched(float lvl) => not na(lvl) and low <= lvl and high >= lvl

if alertOn and plName.size() > 0
    px = str.tostring(close, format.mintick)
    for i = 0 to plName.size() - 1
        inScope = alertScope == "All plans" or planSel == "S" + str.tostring(i + 1)
        if inScope
            f = fired.get(i)
            nm = plName.get(i)
            e = plEntry.get(i)
            if aApproach > 0 and not na(e) and math.abs(close - e) <= aApproach and not str.contains(f, "A") and not str.contains(f, "E") and not touched(e)
                alert("C&T " + nm + ": approaching entry " + fmtPx(e) + " (SPY " + px + ")", alert.freq_once_per_bar)
                f += "A"
            if aEntry and touched(e) and not str.contains(f, "E")
                alert("C&T " + nm + ": ENTRY " + fmtPx(e) + " touched (SPY " + px + ")", alert.freq_once_per_bar)
                f += "E"
            if aTgt and touched(plTgt.get(i)) and not str.contains(f, "T")
                alert("C&T " + nm + ": 50% TARGET " + fmtPx(plTgt.get(i)) + " touched (SPY " + px + ")", alert.freq_once_per_bar)
                f += "T"
            if aStop and touched(plStop.get(i)) and not str.contains(f, "S")
                alert("C&T " + nm + ": PRICE STOP " + fmtPx(plStop.get(i)) + " touched (SPY " + px + ")", alert.freq_once_per_bar)
                f += "S"
            if aInv and touched(plInv.get(i)) and not str.contains(f, "I")
                alert("C&T " + nm + ": INVALIDATION " + fmtPx(plInv.get(i)) + " touched (SPY " + px + ")", alert.freq_once_per_bar)
                f += "I"
            fired.set(i, f)
